{
  "schema": "agentic-os/ci-evidence-policy/v1",
  "repository": "github.com/huijoohwee/agentic-graph",
  "workflow": ".github/workflows/integration.yml",
  "branch": "main",
  "job": "Integration Gate",
  "step": "Run canonical integration gate",
  "command": [
    "npm",
    "run",
    "ci:integration"
  ],
  "dependencies": [
    {
      "id": "canvas",
      "repository": "github.com/huijoohwee/agentic-canvas-os",
      "path": "../agentic-canvas-os"
    },
    {
      "id": "mirror",
      "repository": "github.com/huijoohwee/huijoohwee",
      "path": "../huijoohwee"
    },
    {
      "id": "schema",
      "repository": "github.com/huijoohwee/huijoohwee.github.io",
      "path": "../huijoohwee.github.io"
    }
  ],
  "environment": [
    "NODE_OPTIONS",
    "CI",
    "NODE_ENV",
    "AG_DEV_SOURCE_MODE",
    "VITE_AGENTIC_OS_STORAGE_BASE_URL",
    "AGENTIC_OS_SOURCE_REVISION",
    "AGENTIC_OS_AGENTIC_CANVAS_OS_DOCS_ROOT",
    "AGENTIC_OS_CI_OWNER_INPUTS"
  ],
  "maxAgeSeconds": 86400
}
