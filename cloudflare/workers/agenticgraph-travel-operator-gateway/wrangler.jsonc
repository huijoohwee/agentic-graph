{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "agenticgraph-travel-operator-gateway-dev",
  "main": "index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "services": [
    { "binding": "TRAVEL_COMMERCE_CONTROL", "service": "agenticgraph-travel-commerce" }
  ],
  "vars": {
    "DEPLOY_LANE": "Dev_Lane",
    "ACCESS_ISSUER": "https://replace-with-dev-team.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "replace-with-dev-access-audience",
    "ACCESS_JWKS_TIMEOUT_MS": "3000",
    "ACCESS_JWKS_CACHE_TTL_MS": "300000",
    "TRAVEL_CONTROL_TIMEOUT_MS": "5000"
  },
  // Configure a unique internal token in every environment. It must equal the
  // travel Worker's RECONCILIATION_OPERATOR_TOKEN and must never equal its API token:
  //   wrangler secret put RECONCILIATION_OPERATOR_TOKEN --config <this file> --env=''
  //   wrangler secret put RECONCILIATION_OPERATOR_TOKEN --config <this file> --env staging
  //   wrangler secret put RECONCILIATION_OPERATOR_TOKEN --config <this file> --env production
  // Replace ACCESS_ISSUER/AUDIENCE with the Cloudflare Access application values
  // before deployment; committed sentinels make `/readyz` fail closed.
  "env": {
    "staging": {
      "name": "agenticgraph-travel-operator-gateway-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "services": [
        { "binding": "TRAVEL_COMMERCE_CONTROL", "service": "agenticgraph-travel-commerce-staging" }
      ],
      "vars": {
        "DEPLOY_LANE": "Staging_Lane",
        "ACCESS_ISSUER": "https://replace-with-staging-team.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "replace-with-staging-access-audience",
        "ACCESS_JWKS_TIMEOUT_MS": "3000",
        "ACCESS_JWKS_CACHE_TTL_MS": "300000",
        "TRAVEL_CONTROL_TIMEOUT_MS": "5000"
      }
    },
    "production": {
      "name": "agenticgraph-travel-operator-gateway-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "airvio.co/agenticgraph/control-plane/travel/reconciliation", "zone_name": "airvio.co" },
        { "pattern": "airvio.co/agenticgraph/control-plane/travel/reconciliation/*", "zone_name": "airvio.co" }
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      },
      "services": [
        { "binding": "TRAVEL_COMMERCE_CONTROL", "service": "agenticgraph-travel-commerce-production" }
      ],
      "vars": {
        "DEPLOY_LANE": "Production_Lane",
        "ACCESS_ISSUER": "https://replace-with-production-team.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "replace-with-production-access-audience",
        "ACCESS_JWKS_TIMEOUT_MS": "3000",
        "ACCESS_JWKS_CACHE_TTL_MS": "300000",
        "TRAVEL_CONTROL_TIMEOUT_MS": "5000"
      }
    }
  }
}
