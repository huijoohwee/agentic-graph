{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-marketplace-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["MARKETPLACE_PROVIDER_AUTH_SECRET"] },
  "observability": { "enabled": true },
  "vars": {
    "COMMERCE_PROVIDER_SOURCE_REVISION": "0000000000000000000000000000000000000000",
    "COMMERCE_PROVIDER_STORAGE_REVISION": "marketplace-d1-0017",
    "COMMERCE_PROVIDER_VERSION_ID": ""
  },
  "d1_databases": [{
    "binding": "MARKETPLACE_DB",
    "database_name": "airvio",
    "database_id": "633355bf-1a52-4085-bd3c-eba4220ff152",
    "migrations_dir": "../../d1/migrations"
  }],
  "env": {
    "staging": {
      "name": "agentic-marketplace-staging",
      "secrets": { "required": ["MARKETPLACE_PROVIDER_AUTH_SECRET"] },
      "vars": {
        "COMMERCE_PROVIDER_SOURCE_REVISION": "0000000000000000000000000000000000000000",
        "COMMERCE_PROVIDER_STORAGE_REVISION": "marketplace-d1-0017",
        "COMMERCE_PROVIDER_VERSION_ID": ""
      },
      "d1_databases": [{
        "binding": "MARKETPLACE_DB", "database_name": "airvio",
        "database_id": "633355bf-1a52-4085-bd3c-eba4220ff152", "migrations_dir": "../../d1/migrations"
      }]
    },
    "production": {
      "name": "agentic-marketplace-production",
      "secrets": { "required": ["MARKETPLACE_PROVIDER_AUTH_SECRET"] },
      "vars": {
        "COMMERCE_PROVIDER_SOURCE_REVISION": "0000000000000000000000000000000000000000",
        "COMMERCE_PROVIDER_STORAGE_REVISION": "marketplace-d1-0017",
        "COMMERCE_PROVIDER_VERSION_ID": ""
      },
      "d1_databases": [{
        "binding": "MARKETPLACE_DB", "database_name": "airvio",
        "database_id": "633355bf-1a52-4085-bd3c-eba4220ff152", "migrations_dir": "../../d1/migrations"
      }]
    }
  }
}
