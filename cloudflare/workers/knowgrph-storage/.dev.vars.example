# Local/Dev only. Copy to .dev.vars beside wrangler.toml and provide operator-owned values.
KNOWGRPH_STORAGE_DEV_REMOTE_RELAY_ENABLED=true
KNOWGRPH_STORAGE_REMOTE_RELAY_WORKSPACE_ID=kgws:canonical-docs
KNOWGRPH_STORAGE_SIGNING_SECRET=replace-with-at-least-16-random-characters

KNOWGRPH_STORAGE_GITHUB_TOKEN=replace-with-github-token
KNOWGRPH_STORAGE_GITHUB_OWNER=replace-with-owner
KNOWGRPH_STORAGE_GITHUB_KNOWGRPH_REPO=knowgrph
KNOWGRPH_STORAGE_GITHUB_WORKSPACE_REPO=replace-with-workspace-docs-repository
KNOWGRPH_STORAGE_GITHUB_BRANCH=replace-with-explicit-dev-branch
KNOWGRPH_STORAGE_GIT_KNOWGRPH_REMOTE_ID=origin
KNOWGRPH_STORAGE_GIT_WORKSPACE_REMOTE_ID=workspace-origin
KNOWGRPH_STORAGE_GIT_ALLOWED_PATH_PREFIXES=docs

# Prefer OAuth refresh credentials. Do not add scopes here; preserve the operator-authorized grant.
KNOWGRPH_STORAGE_GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-client-id
KNOWGRPH_STORAGE_GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-client-secret
KNOWGRPH_STORAGE_GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-google-refresh-token
KNOWGRPH_STORAGE_GOOGLE_DRIVE_ID=replace-with-google-drive-id-if-needed
KNOWGRPH_STORAGE_GOOGLE_DRIVE_ROOT_ID=replace-with-google-root-id

KNOWGRPH_STORAGE_ONEDRIVE_TENANT_ID=replace-with-microsoft-tenant-id
KNOWGRPH_STORAGE_ONEDRIVE_CLIENT_ID=replace-with-microsoft-oauth-client-id
KNOWGRPH_STORAGE_ONEDRIVE_CLIENT_SECRET=replace-with-microsoft-oauth-client-secret
KNOWGRPH_STORAGE_ONEDRIVE_REFRESH_TOKEN=replace-with-microsoft-refresh-token
KNOWGRPH_STORAGE_ONEDRIVE_DRIVE_ID=replace-with-onedrive-drive-id
KNOWGRPH_STORAGE_ONEDRIVE_ROOT_ID=replace-with-onedrive-root-id
