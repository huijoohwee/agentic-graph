{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowgrph-travel-ollama-overflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "containers": [
    {
      "class_name": "OllamaContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "OLLAMA_MODEL_REF": "qwen3:0.6b",
        "OLLAMA_MODEL_MANIFEST_SHA256": "7df6b6e09427a769808717c0a93cadc4ae99ed4eb8bf5ca557c90846becea435"
      },
      "instance_type": "standard-1",
      "max_instances": 1,
      "rollout_step_percentage": [100]
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OLLAMA_CONTAINER", "class_name": "OllamaContainer" }]
  },
  "migrations": [{ "tag": "v1_ollama_container", "new_sqlite_classes": ["OllamaContainer"] }],
  "vars": {
    "ALLOWED_MODELS_JSON": "[\"qwen3:0.6b\"]",
    "MODEL_MANIFEST_DIGESTS_JSON": "{\"qwen3:0.6b\":\"7df6b6e09427a769808717c0a93cadc4ae99ed4eb8bf5ca557c90846becea435\"}"
  },
  "env": {
    "staging": {
      "name": "knowgrph-travel-ollama-overflow-staging",
      "workers_dev": true,
      "preview_urls": true,
      "containers": [
        {
          "class_name": "OllamaContainer",
          "image": "./Dockerfile",
          "image_vars": {
            "OLLAMA_MODEL_REF": "qwen3:0.6b",
            "OLLAMA_MODEL_MANIFEST_SHA256": "7df6b6e09427a769808717c0a93cadc4ae99ed4eb8bf5ca557c90846becea435"
          },
          "instance_type": "standard-1",
          "max_instances": 1,
          "rollout_step_percentage": [100]
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "OLLAMA_CONTAINER", "class_name": "OllamaContainer" }]
      },
      "vars": {
        "ALLOWED_MODELS_JSON": "[\"qwen3:0.6b\"]",
        "MODEL_MANIFEST_DIGESTS_JSON": "{\"qwen3:0.6b\":\"7df6b6e09427a769808717c0a93cadc4ae99ed4eb8bf5ca557c90846becea435\"}"
      }
    }
  }
}
