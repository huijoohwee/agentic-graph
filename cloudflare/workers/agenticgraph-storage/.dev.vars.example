# Local/Dev only. Copy to .dev.vars beside wrangler.toml and provide operator-owned values.
AGENTICGRAPH_STORAGE_DEV_REMOTE_RELAY_ENABLED=true
AGENTICGRAPH_STORAGE_REMOTE_RELAY_WORKSPACE_ID=kgws:canonical-docs
AGENTICGRAPH_STORAGE_SIGNING_SECRET=replace-with-at-least-16-random-characters

# Shared Canvas accepted travel mutation -> travel-commerce service binding.
# The caller token must exactly match TRAVEL_COMMERCE_API_TOKEN on the bound Worker.
AGENTICGRAPH_TRAVEL_COMMERCE_API_TOKEN=replace-with-matching-random-token-at-least-32-characters
SHARED_NODE_TRAVEL_BUNDLE_MAP_JSON={"schema":"agenticgraph-shared-canvas-travel-bundle-map/v1","revision":"replace-with-immutable-revision","entries":[{"workspace_id":"replace-with-workspace-id","room_id":"replace-with-room-id","node_id":"replace-with-node-id","bundle_id":"replace-with-bundle-id","initialization_seed":{"principal_id":"replace-with-principal-id","total_budget_minor":50000,"legs":[{"leg_id":"replace-with-leg-id","category":"flight","committed_offer_id":"replace-with-offer-id","committed_amount_minor":10000}],"edges":[]}}]}

# Read-only Lark ingestion. Literal placeholders intentionally fail closed with zero upstream fetches.
AGENTICGRAPH_STORAGE_LARK_IDENTITY_MODE=<tenant-app|user-oauth>
AGENTICGRAPH_STORAGE_LARK_APP_ID=replace-with-lark-app-id
AGENTICGRAPH_STORAGE_LARK_APP_SECRET=replace-with-lark-app-secret
AGENTICGRAPH_STORAGE_LARK_USER_ACCESS_TOKEN=replace-with-preprovisioned-user-oauth-token
AGENTICGRAPH_STORAGE_LARK_USER_ACCESS_TOKEN_EXPIRES_AT_MS=replace-with-unix-epoch-ms
AGENTICGRAPH_STORAGE_LARK_SOURCE_ALLOWLIST_JSON={"schema":"agenticgraph-knowledge-source-allowlist/v1","revision":"replace-with-revision","sources":[]}

AGENTICGRAPH_STORAGE_GITHUB_TOKEN=replace-with-github-token
AGENTICGRAPH_STORAGE_GITHUB_OWNER=replace-with-owner
AGENTICGRAPH_STORAGE_GITHUB_AGENTICGRAPH_REPO=agenticgraph
AGENTICGRAPH_STORAGE_GITHUB_WORKSPACE_REPO=replace-with-workspace-docs-repository
AGENTICGRAPH_STORAGE_GITHUB_BRANCH=replace-with-explicit-dev-branch
AGENTICGRAPH_STORAGE_GIT_AGENTICGRAPH_REMOTE_ID=origin
AGENTICGRAPH_STORAGE_GIT_WORKSPACE_REMOTE_ID=workspace-origin
AGENTICGRAPH_STORAGE_GIT_ALLOWED_PATH_PREFIXES=docs

# Prefer OAuth refresh credentials. Do not add scopes here; preserve the operator-authorized grant.
AGENTICGRAPH_STORAGE_GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-client-id
AGENTICGRAPH_STORAGE_GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-client-secret
AGENTICGRAPH_STORAGE_GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-google-refresh-token
AGENTICGRAPH_STORAGE_GOOGLE_DRIVE_ID=replace-with-google-drive-id-if-needed
AGENTICGRAPH_STORAGE_GOOGLE_DRIVE_ROOT_ID=replace-with-google-root-id

AGENTICGRAPH_STORAGE_ONEDRIVE_TENANT_ID=replace-with-microsoft-tenant-id
AGENTICGRAPH_STORAGE_ONEDRIVE_CLIENT_ID=replace-with-microsoft-oauth-client-id
AGENTICGRAPH_STORAGE_ONEDRIVE_CLIENT_SECRET=replace-with-microsoft-oauth-client-secret
AGENTICGRAPH_STORAGE_ONEDRIVE_REFRESH_TOKEN=replace-with-microsoft-refresh-token
AGENTICGRAPH_STORAGE_ONEDRIVE_DRIVE_ID=replace-with-onedrive-drive-id
AGENTICGRAPH_STORAGE_ONEDRIVE_ROOT_ID=replace-with-onedrive-root-id
