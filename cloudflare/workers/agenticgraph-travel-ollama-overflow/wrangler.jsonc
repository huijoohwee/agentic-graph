{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenticgraph-travel-ollama-overflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "ALLOWED_MODELS_JSON": "[\"@cf/openai/gpt-oss-20b\"]"
  },
  "env": {
    "staging": {
      "name": "agenticgraph-travel-ollama-overflow-staging",
      "workers_dev": true,
      "preview_urls": true,
      "ai": { "binding": "AI", "remote": true },
      "vars": {
        "ALLOWED_MODELS_JSON": "[\"@cf/openai/gpt-oss-20b\"]"
      }
    }
  }
}
