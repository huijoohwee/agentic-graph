{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "agentic-miaoxyz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-miaoxyz-dev",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["OPERATOR_ACCESS_TOKEN", "RATE_LIMIT_HMAC_SECRET"]
  },
  "vars": {
    "APP_BASE_PATH": "",
    "DEPLOYMENT_ENV": "dev",
    "RELEASE_SOURCE_REVISION": "local-dev",
    "RELEASE_CANDIDATE_DIGEST": "local-dev",
    "PRIVACY_BASELINE_APPROVED": "false",
    "DATA_REGION_APPROVED": "false",
    "BACKUP_RESTORE_APPROVED": "false",
    "RATE_LIMIT_REVIEW_APPROVED": "false"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "production": {
      "name": "agentic-miaoxyz-production",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [
        { "pattern": "airvio.co/MiaoXYZ*", "zone_name": "airvio.co" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentic-miaoxyz-production",
          "database_id": "cc6558f0-03cd-4401-8c20-51909b437174",
          "migrations_dir": "migrations"
        }
      ],
      "secrets": {
        "required": ["OPERATOR_ACCESS_TOKEN", "RATE_LIMIT_HMAC_SECRET"]
      },
      "vars": {
        "APP_BASE_PATH": "/MiaoXYZ",
        "DEPLOYMENT_ENV": "production",
        "RELEASE_SOURCE_REVISION": "unreleased",
        "RELEASE_CANDIDATE_DIGEST": "unreleased",
        "PRIVACY_BASELINE_APPROVED": "true",
        "DATA_REGION_APPROVED": "true",
        "BACKUP_RESTORE_APPROVED": "true",
        "RATE_LIMIT_REVIEW_APPROVED": "true"
      },
      "triggers": {
        "crons": ["17 3 * * *"]
      }
    }
  }
}
