#!/bin/sh
# ADLC guard: no direct push to the profile's canonical branch.
#
# Scoped to the destination ref only, so pushing a lane ref from any worktree
# stays allowed.
[ "$AGENTIC_OS_ALLOW_CANONICAL_WRITE" = "1" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 1
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
protected=$(node "$hook_dir/../src/guard-main.mjs" protected-ref) || exit 1

case "$protected" in
  refs/heads/*) ;;
  *)
    printf '\nagentic-os: invalid canonical destination ref: %s\n\n' "$protected" >&2
    exit 1
    ;;
esac

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue
  printf '\nagentic-os: refusing to push directly to %s.\n\n' "$protected" >&2
  printf 'Every change lands through protected integration:\n\n  npm run land\n\n' >&2
  printf 'Override for a repository-owned operation: AGENTIC_OS_ALLOW_CANONICAL_WRITE=1\n\n' >&2
  exit 1
done

exit 0
