{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowgrph.dev/schema/apple-spatial-input-profile.v1.schema.json",
  "title": "Apple Spatial Input Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "controlRangeDegrees",
    "jitterThresholdDegrees",
    "settledAxisThreshold",
    "smoothingRatePerSecond",
    "calibrationTimeoutMilliseconds"
  ],
  "properties": {
    "schema": {
      "const": "airvio.apple-spatial-input/v1"
    },
    "controlRangeDegrees": {
      "type": "number",
      "minimum": 5,
      "maximum": 90
    },
    "jitterThresholdDegrees": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "settledAxisThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.1
    },
    "smoothingRatePerSecond": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "calibrationTimeoutMilliseconds": {
      "type": "number",
      "minimum": 250,
      "maximum": 10000
    }
  }
}
