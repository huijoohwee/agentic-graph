{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowgrph.dev/schemas/collaboration-runtime-report/v1",
  "title": "Knowgrph Collaboration Runtime Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "contractVersion",
    "sourceRevision",
    "policies"
  ],
  "properties": {
    "schema": {
      "const": "knowgrph.collaboration-runtime-report/v1"
    },
    "status": {
      "const": "passed"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentIsolation",
        "runtimeDocsWorkflow",
        "pullRequestCoordination"
      ],
      "properties": {
        "deploymentIsolation": {
          "$ref": "#/$defs/deploymentIsolation"
        },
        "runtimeDocsWorkflow": {
          "$ref": "#/$defs/runtimeDocsWorkflow"
        },
        "pullRequestCoordination": {
          "$ref": "#/$defs/pullRequestCoordination"
        }
      }
    }
  },
  "$defs": {
    "deploymentIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "workflowCount",
        "deploymentWorkflowCount",
        "allowedWorkflows"
      ],
      "properties": {
        "id": {
          "const": "deployment-isolation/v1"
        },
        "status": {
          "const": "passed"
        },
        "workflowCount": {
          "type": "integer",
          "minimum": 1
        },
        "deploymentWorkflowCount": {
          "type": "integer",
          "minimum": 1
        },
        "allowedWorkflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflowPath"
          }
        }
      }
    },
    "runtimeDocsWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "consumerCount",
        "consumers",
        "checks"
      ],
      "properties": {
        "id": {
          "const": "runtime-docs-workflow/v1"
        },
        "status": {
          "const": "passed"
        },
        "consumerCount": {
          "type": "integer",
          "minimum": 1
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflowPath"
          }
        },
        "checks": {
          "const": [
            "dependencies-installed",
            "contract-resolver-after-install",
            "checkout-after-resolver",
            "resolver-step-id",
            "silent-resolver-command",
            "contract-derived-repository",
            "contract-derived-ref",
            "full-history-checkout",
            "no-copied-ref"
          ]
        }
      }
    },
    "pullRequestCoordination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status"
          ],
          "properties": {
            "id": {
              "const": "pull-request-coordination/v1"
            },
            "status": {
              "const": "not-applicable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "pullNumber",
            "draft",
            "scope",
            "authority",
            "remoteAuthorityRequired",
            "remoteAuthorityCheck",
            "claimId",
            "claimDigest",
            "ledgerRevision",
            "writeSetDigest",
            "verificationReceiptDigest"
          ],
          "properties": {
            "id": {
              "const": "pull-request-coordination/v1"
            },
            "status": {
              "const": "passed"
            },
            "pullNumber": {
              "type": "integer",
              "minimum": 1
            },
            "draft": {
              "type": "boolean"
            },
            "scope": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "authority": {
              "const": "agentic-canvas-os-remote-ledger"
            },
            "remoteAuthorityCheck": {
              "enum": [
                "passed",
                "skipped",
                "not-applicable"
              ]
            },
            "claimId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "claimDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ledgerRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "writeSetDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verificationReceiptDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "remoteAuthorityRequired": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "draft": {
                    "const": true
                  }
                },
                "required": [
                  "draft"
                ]
              },
              "then": {
                "properties": {
                  "remoteAuthorityRequired": {
                    "const": false
                  },
                  "remoteAuthorityCheck": {
                    "const": "not-applicable"
                  }
                }
              },
              "else": {
                "properties": {
                  "remoteAuthorityCheck": {
                    "enum": [
                      "passed",
                      "skipped"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "remoteAuthorityRequired": {
                    "const": true
                  }
                },
                "required": [
                  "remoteAuthorityRequired"
                ]
              },
              "then": {
                "properties": {
                  "draft": {
                    "const": false
                  },
                  "remoteAuthorityCheck": {
                    "const": "passed"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "remoteAuthorityCheck": {
                    "const": "passed"
                  }
                },
                "required": [
                  "remoteAuthorityCheck"
                ]
              },
              "then": {
                "properties": {
                  "claimId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "claimDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "ledgerRevision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "writeSetDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "verificationReceiptDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "else": {
                "properties": {
                  "claimId": {
                    "type": "null"
                  },
                  "claimDigest": {
                    "type": "null"
                  },
                  "ledgerRevision": {
                    "type": "null"
                  },
                  "writeSetDigest": {
                    "type": "null"
                  },
                  "verificationReceiptDigest": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "workflowPath": {
      "type": "string",
      "pattern": "^\\.github/workflows/.+\\.ya?ml$"
    }
  }
}
