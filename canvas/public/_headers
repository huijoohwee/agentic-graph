/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The /agentic-graph canvas is embedded by the agentic-canvas-os Vercel product
# tier (airvio.co/agentic-graph framed by *.vercel.app for 100% fidelity).
# frame-ancestors replaces X-Frame-Options: DENY on the canvas paths only.
# All other paths remain non-embeddable (frame-ancestors 'self' is restrictive).
/agentic-graph*
  Content-Security-Policy: frame-ancestors 'self' https://*.vercel.app https://*.joohwee.pages.dev
  X-Content-Type-Options: nosniff

# Keep powerful features same-origin and scoped to the agentic-graph application.
# The published mirror has a global deny policy and uses the generated
# path-specific detach/attach block in scripts/sync-pages-agentic-graph.mjs.
/agentic-graph/*
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(self), clipboard-read=(), clipboard-write=(), display-capture=(self), geolocation=(), gyroscope=(self), magnetometer=(self), microphone=(self), payment=(), usb=(), xr-spatial-tracking=(self)

/content/agentic-graph/*
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(self), clipboard-read=(), clipboard-write=(), display-capture=(self), geolocation=(), gyroscope=(self), magnetometer=(self), microphone=(self), payment=(), usb=(), xr-spatial-tracking=(self)

/agentic-graph/doc-view
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Security-Policy: frame-ancestors 'self' https://*.vercel.app https://*.joohwee.pages.dev

# All other routes stay frame-denied

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cesium/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/agentic-graph-chat-stream-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/agentic-graph-service-worker-revision.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
