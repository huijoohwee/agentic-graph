{
  "schema": "agentic-os/repository-validation-policy/v1",
  "repository": "github.com/huijoohwee/agentic-graph",
  "broadInputs": [],
  "always": [],
  "fallback": [
    "graph-standard-plan",
    "graph-extended-plan"
  ],
  "checks": [
    {
      "id": "graph-standard-plan",
      "command": [
        "npm",
        "run",
        "ci:affected:source",
        "--",
        "--partition=standard"
      ],
      "inputs": [
        "*"
      ],
      "requires": [],
      "reuse": "never",
      "timeoutMs": 900000
    },
    {
      "id": "graph-extended-plan",
      "command": [
        "npm",
        "run",
        "ci:affected:source",
        "--",
        "--partition=extended"
      ],
      "inputs": [
        "*"
      ],
      "requires": [
        "graph-standard-plan"
      ],
      "reuse": "never",
      "timeoutMs": 900000
    }
  ],
  "reviewBodyCheck": "scripts/collaboration-contract.mjs"
}
